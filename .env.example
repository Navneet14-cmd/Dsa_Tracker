# ---------------------------------------------------------------------------
# Database (matches docker-compose.yml: `docker compose up -d db`)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://dsa:dsa@localhost:5432/dsatracker?schema=public"
# Used by `npm test`. Must point at a database whose name contains "test":
# the test setup resets it.
TEST_DATABASE_URL="postgresql://dsa:dsa@localhost:5432/dsatracker_test?schema=public"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Comma-separated allowed browser origins, or "*". Leave empty to allow any
# origin in development and none in production. (Native apps send no Origin.)
CORS_ORIGINS=""
# Number of reverse-proxy hops to trust for client IPs (0 when not behind one).
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace_with_a_long_random_secret"
# jsonwebtoken/ms format: 7d, 12h, 3600 (seconds)...
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Login/register/change-password attempts per IP per window
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# ---------------------------------------------------------------------------
# AI (Anthropic Claude)
# ---------------------------------------------------------------------------
# Leave empty to run the AI endpoints in mock mode (outside production).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=claude-opus-5-5
# Model to retry on if the primary model declines a request. Defaults to
# claude-opus-4-8 when ANTHROPIC_MODEL is the default; set empty to disable.
# ANTHROPIC_FALLBACK_MODEL=claude-opus-4-8
# Overall deadline for one AI request, including web searches
AI_TIMEOUT_MS=60000
AI_WEB_SEARCH_MAX_USES=3
# AI requests per user per window
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=3600000
