# Database Connection URL (e.g. PostgreSQL or SQLite)
DATABASE_URL="postgresql://username:password@localhost:5432/dsatracker?schema=public"

# Express Server Port
PORT=3000

# JWT Auth Secret Signature
JWT_SECRET="your_jwt_secret_signing_key_here"

# Anthropic API Configuration (for Claude Recommendations & Planners)
# If unconfigured/empty in development, the server runs in Mock Development Mode.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
