# ---------------------------------------------------------------------------
# Database (matches docker-compose.yml: `docker compose up -d db`)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://dsa:dsa@localhost:5432/dsatracker?schema=public"
# Used by `npm test`. Must point at a database whose name contains "test":
# the test setup resets it.
TEST_DATABASE_URL="postgresql://dsa:dsa@localhost:5432/dsatracker_test?schema=public"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
# Interface to listen on. 0.0.0.0 = all interfaces, so phones on the LAN or
# Tailscale can reach it. Use 127.0.0.1 to allow this machine only.
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated allowed browser origins, or "*". Leave empty to allow any
# origin in development and none in production. (Native apps send no Origin.)
CORS_ORIGINS=""
# Number of reverse-proxy hops to trust for client IPs (0 when not behind one).
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace_with_a_long_random_secret"
# jsonwebtoken/ms format: 7d, 12h, 3600 (seconds)...
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Login/register/change-password attempts per IP per window
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# Which provider powers /ai/*:
#   rules     - built-in heuristics + a curated LeetCode list. No model, always available.
#   ollama    - a local model served by Ollama (see OLLAMA_* below).
#   anthropic - Claude via the Anthropic API (needs ANTHROPIC_API_KEY).
# If ollama/anthropic fails or times out, the request falls back to rules
# (the response then has source "rules" and fallbackFrom set).
AI_PROVIDER=rules

# AI requests per user per window (GET /ai/status is not limited)
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=3600000

# --- Ollama (AI_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:7b needs ~16 GB RAM to run comfortably; on 8 GB machines use
# qwen2.5:3b or llama3.2:3b. Pull it first: ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b
# CPU-only inference on a laptop is slow; keep this generous (ms).
OLLAMA_TIMEOUT_MS=150000

# --- Anthropic (AI_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=""
# Recommendations (uses web search to verify problem numbers)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Weakness analysis and study plans
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# Deadline for one Claude request, including web searches (ms)
ANTHROPIC_TIMEOUT_MS=60000
AI_WEB_SEARCH_MAX_USES=3
